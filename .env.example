# Public site URL used for Open Graph and the sitemap.
# Set this to the domain after you add it in Vercel, for example https://demoboyz.ca
NEXT_PUBLIC_SITE_URL=

# Resend sends the request form to kyle@demo-boyz.com.
# Verify the sending domain in Resend, then set both values in Vercel.
RESEND_API_KEY=
RESEND_FROM="Demo-Boyz <hello@demo-boyz.com>"
